# Optional comma-separated ICE server configuration.
PUBLIC_STUN_URLS=stun:stun.l.google.com:19302
PUBLIC_TURN_URLS=
PUBLIC_TURN_USERNAME=
PUBLIC_TURN_CREDENTIAL=

# Use "relay" only to verify TURN operation; the default is "all".
PUBLIC_ICE_TRANSPORT_POLICY=all

# Never enable this in a normal public production build.
PUBLIC_SCRUM_POKER_DEBUG=false
