---
interface Props {
  class?: string;
  iconClass?: string;
  linkClass?: string;
}

const {
  class: className,
  iconClass,
  linkClass,
} = Astro.props;
---

<span class:list={['inline-flex items-center gap-1.5 normal-case', className]}>
  Made with
  <span class="sr-only">love</span>
  <svg
    class:list={['size-3 fill-accent', iconClass]}
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <path
      d="M12 21s-7.5-4.4-9.6-8.4C.5 9 2.1 4.5 6.3 3.4c2.3-.6 4.5.3 5.7 2 1.2-1.7 3.4-2.6 5.7-2 4.2 1.1 5.8 5.6 3.9 9.2C19.5 16.6 12 21 12 21Z"
    ></path>
  </svg>
  by <a
    class:list={[
      'text-foreground underline decoration-rule hover:decoration-accent',
      linkClass,
    ]}
    href="/">Brijesh</a
  >
</span>
