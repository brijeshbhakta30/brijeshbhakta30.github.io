---
import type { ToolItem } from '../data/tools';

interface Props {
  tool: ToolItem;
  index: number;
}

const { tool, index } = Astro.props;
const borderedClass = index > 0 ? 'border-t border-rule last:border-b' : '';
const label = String(index + 1).padStart(2, '0');
---

<a
  class:list={[
    "group grid grid-cols-[1fr_2fr_auto] items-center gap-8 py-8 no-underline max-mobile:grid-cols-[1fr_auto]",
    borderedClass
  ]}
  href={tool.href}
>
  <p class="m-0 font-mono text-sm tracking-[0.06em] text-accent uppercase">
    {label} / {tool.category}
  </p>
  <div class="max-mobile:col-span-full max-mobile:row-start-2">
    <h2
      class="m-0 font-serif text-[clamp(2rem,4vw,4rem)] leading-none font-normal tracking-[-0.03em]"
    >
      {tool.title}
    </h2>
    <p class="mt-3 mb-0 max-w-[650px] text-secondary">
      {tool.description}
    </p>
  </div>
  <span
    class="text-2xl transition-transform group-hover:translate-x-1"
    aria-hidden="true">→</span
  >
</a>
