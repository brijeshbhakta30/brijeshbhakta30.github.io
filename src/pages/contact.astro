---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact" description="Contact software engineer Brijesh Bhakta by email or connect on GitHub and X.">
  <header class="border-b border-rule pt-[clamp(4.5rem,9vw,9rem)] pb-[clamp(3rem,6vw,6rem)]">
    <p class="mb-5 font-mono text-base font-semibold tracking-[0.12em] text-accent uppercase before:content-['//_']">Contact</p>
    <h1 class="mb-8 max-w-[980px] font-serif text-[clamp(3.4rem,7vw,7rem)] leading-[0.98] font-normal tracking-[-0.035em]">Let’s talk through the problem.</h1>
    <p class="max-w-[720px] text-[clamp(1.2rem,2vw,1.55rem)] leading-normal text-secondary">For engineering opportunities, product conversations, or a thoughtful technical exchange, email is the best place to start.</p>
  </header>
  <section class="border-b border-rule py-[clamp(5rem,10vw,10rem)]">
    <ul class="m-0 list-none border-t border-rule p-0 [&_a]:grid [&_a]:grid-cols-[1fr_2fr_auto] [&_a]:items-center [&_a]:gap-8 [&_a]:border-b [&_a]:border-rule [&_a]:py-8 [&_a]:no-underline max-mobile:[&_a]:grid-cols-[1fr_auto] max-mobile:[&_a]:gap-x-4 max-mobile:[&_a]:gap-y-[0.4rem] [&_span:first-child]:font-mono [&_span:first-child]:text-[0.8rem] [&_span:first-child]:uppercase [&_strong]:[overflow-wrap:anywhere] [&_strong]:font-serif [&_strong]:text-[clamp(1.35rem,3vw,2.4rem)] [&_strong]:font-normal max-mobile:[&_strong]:col-span-full max-mobile:[&_strong]:row-start-2">
      <li><a href="mailto:brijeshbhakta30@gmail.com"><span>01 / Email</span><strong>brijeshbhakta30@gmail.com</strong><span aria-hidden="true">↗</span></a></li>
      <li><a href="https://github.com/brijeshbhakta30" rel="me"><span>02 / Code</span><strong>github.com/brijeshbhakta30</strong><span aria-hidden="true">↗</span></a></li>
      <li><a href="https://twitter.com/brijeshbhakta30" rel="me"><span>03 / Social</span><strong>@brijeshbhakta30</strong><span aria-hidden="true">↗</span></a></li>
    </ul>
  </section>
</BaseLayout>
