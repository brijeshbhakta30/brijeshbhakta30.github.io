---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('writing', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.data.permalink.replace(/^\//, '').replace(/\/$/, '') },
    props: { post },
  }));
}

interface Props { post: CollectionEntry<'writing'>; }
const { post } = Astro.props;
const { Content } = await render(post);
const formattedDate = new Intl.DateTimeFormat('en', { day: '2-digit', month: 'long', year: 'numeric' }).format(post.data.publishedAt);
---

<BaseLayout title={post.data.title} description={post.data.description} article>
  <article>
    <header class="border-b border-rule pt-[clamp(4.5rem,9vw,9rem)] pb-[clamp(3rem,6vw,6rem)]">
      <a class="mb-[clamp(3rem,6vw,6rem)] inline-block font-mono text-[0.8rem] tracking-[0.06em] text-accent uppercase" href="/writing"><span aria-hidden="true">←</span> Back to writing</a>
      <p class="mb-5 font-mono text-base font-semibold tracking-[0.12em] text-accent uppercase before:content-['//_']">{post.data.category} · {formattedDate}</p>
      <h1 class="mb-8 max-w-[980px] font-serif text-[clamp(3.4rem,7vw,7rem)] leading-[0.98] font-normal tracking-[-0.035em]">{post.data.title}</h1>
      <p class="max-w-[720px] text-[clamp(1.2rem,2vw,1.55rem)] leading-normal text-secondary">{post.data.description}</p>
      <ul class="mt-4 flex list-none flex-wrap gap-2 p-0" aria-label="Article topics">
        {post.data.tags.map((tag) => <li class="border border-rule px-[0.6rem] py-[0.3rem] font-mono text-[0.8rem] tracking-[0.04em] text-muted uppercase">{tag}</li>)}
      </ul>
    </header>
    <div class="grid grid-cols-[minmax(160px,1fr)_minmax(0,760px)_1fr] gap-8 py-[clamp(4rem,8vw,8rem)] max-mobile:block">
      <aside class="sticky top-8 self-start font-mono text-[0.8rem] leading-[1.8] tracking-[0.05em] text-muted uppercase max-mobile:static max-mobile:mb-12" aria-label="Article information">
        <p>Published<br />{formattedDate}</p>
        <p>Filed under<br />{post.data.category}</p>
      </aside>
      <div class="prose col-start-2 min-w-0"><Content /></div>
    </div>
  </article>
</BaseLayout>
