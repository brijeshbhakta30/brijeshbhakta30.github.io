---
import { render, type CollectionEntry } from 'astro:content';
import DraftBadge from '../components/DraftBadge.astro';
import PageHeader from '../components/PageHeader.astro';
import TagList from '../components/TagList.astro';
import TextLink from '../components/TextLink.astro';
import { getWritingPosts } from '../data/writing';
import BaseLayout from '../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getWritingPosts();
  return posts.map((post) => ({
    params: { slug: post.data.permalink.replace(/^\//, '').replace(/\/$/, '') },
    props: { post },
  }));
}

interface Props { post: CollectionEntry<'writing'>; }
const { post } = Astro.props;
const { Content } = await render(post);
const formattedDate = new Intl.DateTimeFormat('en', { day: '2-digit', month: 'long', year: 'numeric' }).format(post.data.publishedAt);
---

<BaseLayout title={post.data.title} description={post.data.description} article>
  <article>
    <PageHeader
      eyebrow={`${post.data.category} · ${formattedDate}`}
      title={post.data.title}
      description={post.data.description}
    >
      <Fragment slot="before">
        <TextLink
          class="mb-[clamp(3rem,6vw,6rem)]"
          href="/writing"
          accent><span aria-hidden="true">←</span> Back to writing</TextLink
        >
        {post.data.draft && <div class="mb-6"><DraftBadge /></div>}
      </Fragment>
      <TagList tags={post.data.tags} label="Article topics" />
    </PageHeader>
    <div class="grid grid-cols-[minmax(160px,1fr)_minmax(0,760px)_1fr] gap-8 py-[clamp(4rem,8vw,8rem)] max-mobile:block">
      <aside class="sticky top-8 self-start font-mono text-[0.8rem] leading-[1.8] tracking-[0.05em] text-muted uppercase max-mobile:static max-mobile:mb-12" aria-label="Article information">
        {post.data.draft && <p class="text-accent">Status<br />Draft</p>}
        <p>Published<br />{formattedDate}</p>
        <p>Filed under<br />{post.data.category}</p>
      </aside>
      <div class="prose col-start-2 min-w-0"><Content /></div>
    </div>
  </article>
</BaseLayout>
