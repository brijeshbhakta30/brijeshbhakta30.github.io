---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Tools" description="Small, focused browser tools for product and engineering teams.">
  <header class="border-b border-rule pt-[clamp(4.5rem,9vw,9rem)] pb-[clamp(3rem,6vw,6rem)]">
    <p class="mb-5 font-mono text-base font-semibold tracking-[0.12em] text-accent uppercase before:content-['//_']">Tools</p>
    <h1 class="mb-8 max-w-[980px] font-serif text-[clamp(3.4rem,7vw,7rem)] leading-[0.98] font-normal tracking-[-0.035em]">Useful software, kept small.</h1>
    <p class="max-w-[720px] text-[clamp(1.2rem,2vw,1.55rem)] leading-normal text-secondary">Focused utilities that run in the browser, without accounts or unnecessary ceremony.</p>
  </header>

  <section class="border-b border-rule py-[clamp(5rem,10vw,10rem)]" aria-label="Available tools">
    <a class="group grid grid-cols-[1fr_2fr_auto] items-center gap-8 border-t border-rule py-8 no-underline max-mobile:grid-cols-[1fr_auto]" href="/tools/scrum-poker">
      <p class="m-0 font-mono text-sm tracking-[0.06em] text-accent uppercase">01 / Collaboration</p>
      <div class="max-mobile:col-span-full max-mobile:row-start-2">
        <h2 class="m-0 font-serif text-[clamp(2rem,4vw,4rem)] leading-none font-normal tracking-[-0.03em]">Scrum Poker</h2>
        <p class="mt-3 mb-0 max-w-[650px] text-secondary">Peer-to-peer planning poker with room links, hidden votes, reveal controls, and round statistics.</p>
      </div>
      <span class="text-2xl transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
    </a>
    <a class="group grid grid-cols-[1fr_2fr_auto] items-center gap-8 border-y border-rule py-8 no-underline max-mobile:grid-cols-[1fr_auto]" href="/tools/wheel-of-names">
      <p class="m-0 font-mono text-sm tracking-[0.06em] text-accent uppercase">02 / Facilitation</p>
      <div class="max-mobile:col-span-full max-mobile:row-start-2">
        <h2 class="m-0 font-serif text-[clamp(2rem,4vw,4rem)] leading-none font-normal tracking-[-0.03em]">Wheel of Names</h2>
        <p class="mt-3 mb-0 max-w-[650px] text-secondary">A simple random name picker for stand-ups, workshops, games, and anywhere you need to choose someone fairly.</p>
      </div>
      <span class="text-2xl transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
    </a>
  </section>
</BaseLayout>
