---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ToolCard from '../../components/ToolCard.astro';
import { tools } from '../../data/tools';
---

<BaseLayout title="Tools" description="Small, focused browser tools for product and engineering teams.">
  <PageHeader
    eyebrow="Tools"
    title="Useful software, kept small."
    description="Focused utilities that run in the browser, without accounts or unnecessary ceremony."
  />

  <section class="border-b border-rule py-[clamp(5rem,10vw,10rem)]" aria-label="Available tools">
    {tools.map((tool, index) => <ToolCard tool={tool} index={index} />)}
  </section>
</BaseLayout>
