---
import ToolLayout from '../../layouts/ToolLayout.astro';

const cards = ['0', '1', '2', '3', '5', '8', '13', '21', '?', '☕'];
---

<ToolLayout title="Scrum Poker" description="A private, peer-to-peer planning poker tool for quick team estimates.">
  <div data-scrum-tool>
    <header class="border-b border-rule py-5">
      <div class="flex items-end justify-between gap-8 max-mobile:items-start">
        <div>
          <p class="mb-1 font-mono text-[0.7rem] font-semibold tracking-[0.12em] text-accent uppercase">Scrum Poker</p>
          <h1 class="m-0 font-serif text-[clamp(1.8rem,3vw,2.8rem)] leading-none font-normal tracking-[-0.03em]">Estimate together.</h1>
        </div>
        <div class="flex items-center justify-end gap-4">
          <p class="m-0 max-w-[460px] text-right text-sm leading-normal text-secondary max-mobile:hidden">
            Peer-to-peer rooms. Votes are not stored.
          </p>
          <button id="profile-button" class="grid size-9 shrink-0 cursor-pointer place-items-center rounded-full border border-rule bg-transparent p-0 text-foreground hover:border-accent-hover hover:text-accent-hover" type="button" aria-label="Open profile settings" title="Profile settings">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
              <circle cx="12" cy="8" r="3.25"></circle>
              <path d="M5.5 19c.7-3.2 3-5 6.5-5s5.8 1.8 6.5 5"></path>
            </svg>
          </button>
          <button class="grid size-9 shrink-0 cursor-pointer place-items-center rounded-full border border-rule bg-transparent p-0 text-foreground hover:border-accent-hover hover:text-accent-hover" type="button" data-tool-theme-toggle aria-label="Switch to dark mode" title="Switch to dark mode">
            <span class="text-base leading-none dark:hidden" aria-hidden="true">☾</span>
            <span class="hidden text-base leading-none dark:inline" aria-hidden="true">☀</span>
          </button>
        </div>
      </div>
    </header>

    <main id="tool-content" class="py-[clamp(2rem,5vw,4rem)]">
      <section id="poker-setup" class="mx-auto max-w-[920px]" aria-labelledby="setup-title">
        <div class="grid grid-cols-[1fr_auto] items-end gap-8 max-mobile:grid-cols-1">
          <div>
            <p class="mb-3 font-mono text-[0.8rem] tracking-[0.08em] text-accent uppercase">Start here</p>
            <h2 id="setup-title" class="m-0 font-serif text-[clamp(2.3rem,4vw,4rem)] leading-none font-normal tracking-[-0.03em]">Make a room or join one.</h2>
          </div>
          <p class="m-0 font-mono text-[0.75rem] tracking-[0.05em] text-muted uppercase">No account · Private votes</p>
        </div>

        <div class="mt-12 grid grid-cols-2 border border-rule bg-surface max-mobile:grid-cols-1">
          <form id="create-room-form" class="p-8 max-mobile:border-b max-mobile:border-rule max-mobile:p-6">
            <span class="font-mono text-[0.75rem] tracking-[0.08em] text-muted uppercase">01 / Facilitate</span>
            <h3 class="mt-8 mb-2 font-serif text-[2rem] font-normal">Create a room</h3>
            <p class="mb-8 text-secondary">Start a fresh round and share the room link with your team.</p>
            <label class="mb-2 block font-mono text-[0.75rem] tracking-[0.06em] uppercase" for="create-name">Your name</label>
            <input id="create-name" class="w-full border border-rule bg-background px-4 py-3 text-foreground outline-none placeholder:text-muted focus:border-accent" name="name" maxlength="32" autocomplete="name" placeholder="e.g. Brijesh" required />
            <label class="mt-4 mb-2 block font-mono text-[0.75rem] tracking-[0.06em] uppercase" for="create-room-code">Custom room ID <span class="text-muted">(optional)</span></label>
            <input id="create-room-code" class="w-full border border-rule bg-background px-4 py-3 font-mono tracking-[0.08em] text-foreground uppercase outline-none placeholder:text-muted focus:border-accent" name="room" minlength="1" maxlength="32" pattern="[A-Z0-9]+" autocomplete="off" placeholder="Leave blank for a random ID" />
            <button class="mt-4 w-full cursor-pointer bg-accent px-5 py-3 font-mono text-[0.8rem] font-semibold tracking-[0.06em] text-background uppercase hover:bg-accent-hover" type="submit">Create room <span aria-hidden="true">↗</span></button>
          </form>

          <form id="join-room-form" class="border-l border-rule p-8 max-mobile:border-l-0 max-mobile:p-6">
            <span class="font-mono text-[0.75rem] tracking-[0.08em] text-muted uppercase">02 / Participate</span>
            <h3 class="mt-8 mb-2 font-serif text-[2rem] font-normal">Join your team</h3>
            <p class="mb-8 text-secondary">Use the uppercase alphanumeric room ID sent by your facilitator.</p>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="mb-2 block font-mono text-[0.75rem] tracking-[0.06em] uppercase" for="join-name">Your name</label>
                <input id="join-name" class="w-full border border-rule bg-background px-4 py-3 text-foreground outline-none placeholder:text-muted focus:border-accent" name="name" maxlength="32" autocomplete="name" placeholder="Your name" required />
              </div>
              <div>
                <label class="mb-2 block font-mono text-[0.75rem] tracking-[0.06em] uppercase" for="room-code">Room code</label>
                <input id="room-code" class="w-full border border-rule bg-background px-4 py-3 font-mono tracking-[0.12em] text-foreground uppercase outline-none placeholder:text-muted focus:border-accent" name="room" minlength="1" maxlength="32" pattern="[A-Z0-9]+" autocomplete="off" placeholder="ABC1234" required />
              </div>
            </div>
            <button class="mt-4 w-full cursor-pointer border border-foreground px-5 py-3 font-mono text-[0.8rem] font-semibold tracking-[0.06em] uppercase hover:border-accent hover:text-accent" type="submit">Join room <span aria-hidden="true">→</span></button>
          </form>
        </div>

        <div id="connection-error" class="mt-4 hidden border-l-[3px] border-accent bg-surface px-5 py-4 text-secondary" role="alert"></div>

        <aside class="mt-8 grid grid-cols-[auto_1fr] gap-4 border-t border-rule pt-6 text-sm text-secondary">
          <span class="mt-1 size-2 rounded-full bg-accent" aria-hidden="true"></span>
          <p class="m-0"><strong class="text-foreground">Private by design.</strong> PeerJS introduces browsers through its public signalling service; names and votes then move over encrypted WebRTC connections. Names and votes are not stored; browser preferences stay on this device.</p>
        </aside>
      </section>

      <section id="poker-room" class="hidden" aria-labelledby="room-heading">
        <div class="flex items-center justify-between gap-6 border-b border-rule pb-5 max-mobile:items-start">
          <div>
            <p id="connection-label" class="mb-1 flex items-center gap-2 font-mono text-[0.75rem] tracking-[0.08em] text-muted uppercase">
              <span id="connection-dot" class="size-2 rounded-full bg-muted" aria-hidden="true"></span>
              Connecting
            </p>
            <h2 id="room-heading" class="m-0 font-serif text-[clamp(2rem,4vw,3.6rem)] leading-none font-normal">Room <span id="room-label" class="font-mono text-[0.7em] tracking-[0.08em] text-accent"></span></h2>
          </div>
          <div class="flex flex-wrap justify-end gap-2">
            <button id="copy-room" class="cursor-pointer border border-rule px-4 py-2 font-mono text-[0.75rem] tracking-[0.05em] uppercase hover:border-accent hover:text-accent" type="button">Copy invite</button>
            <button id="leave-room" class="cursor-pointer border border-rule px-4 py-2 font-mono text-[0.75rem] tracking-[0.05em] uppercase hover:border-accent hover:text-accent" type="button">Leave</button>
          </div>
        </div>

        <div class="mt-8 grid grid-cols-[minmax(0,1fr)_280px] gap-8 max-mobile:grid-cols-1">
          <div>
            <div class="scrum-table">
              <div class="scrum-table-copy">
                <div class="scrum-round-overview">
                  <p id="round-label" class="mb-2 font-mono text-[0.75rem] tracking-[0.08em] text-muted uppercase">Round 1</p>
                  <p id="round-status" class="m-0 font-serif text-[clamp(1.5rem,3vw,2.5rem)] leading-tight">Waiting for estimates</p>
                  <p id="timer-display" class="scrum-timer mt-4 mb-0 font-mono text-lg tracking-[0.08em] text-muted" aria-live="polite">2:00</p>
                </div>
                <div id="statistics" class="scrum-results hidden" aria-live="polite">
                  <section class="scrum-result-summary">
                    <p class="mb-3 font-mono text-[0.7rem] tracking-[0.08em] text-accent uppercase">Round result</p>
                    <div class="scrum-result-stats">
                      <div class="scrum-result-stat"><strong id="stat-most-voted" class="block font-serif text-2xl font-normal">—</strong><span class="font-mono text-[0.6rem] text-muted uppercase">Most voted</span></div>
                      <div class="scrum-result-stat"><strong id="stat-low" class="block font-serif text-2xl font-normal">—</strong><span class="font-mono text-[0.6rem] text-muted uppercase">Low</span></div>
                      <div class="scrum-result-stat"><strong id="stat-high" class="block font-serif text-2xl font-normal">—</strong><span class="font-mono text-[0.6rem] text-muted uppercase">High</span></div>
                    </div>
                    <p id="consensus-label" class="mt-3 mb-0 text-sm text-secondary"></p>
                  </section>
                  <section class="scrum-distribution-panel" aria-label="Vote distribution">
                    <p class="mb-3 font-mono text-[0.65rem] tracking-[0.08em] text-muted uppercase">Vote spread</p>
                    <div id="distribution" class="space-y-2 text-left"></div>
                  </section>
                </div>
              </div>
              <div id="players-grid" class="scrum-players" aria-live="polite"></div>
            </div>

            <div class="mt-8">
              <div class="mb-4 flex items-end justify-between gap-4">
                <div>
                  <p class="mb-1 font-mono text-[0.75rem] tracking-[0.08em] text-accent uppercase">Your estimate</p>
                  <h3 class="m-0 font-serif text-[1.7rem] font-normal">Choose a card</h3>
                </div>
                <p id="card-hint" class="m-0 text-sm text-muted">Tap again to clear</p>
              </div>
              <div id="card-hand" class="scrum-hand" role="group" aria-label="Estimate cards">
                {cards.map((card) => <button class="scrum-hand-card" type="button" data-card={card} aria-pressed="false">{card}</button>)}
              </div>
            </div>
          </div>

          <aside class="border-l border-rule pl-8 max-mobile:border-t max-mobile:border-l-0 max-mobile:pt-8 max-mobile:pl-0">
            <div id="host-controls" class="hidden">
              <p class="mb-4 font-mono text-[0.75rem] tracking-[0.08em] text-accent uppercase">Facilitator controls</p>
              <button id="reveal-votes" class="w-full cursor-pointer bg-accent px-4 py-3 font-mono text-[0.8rem] font-semibold tracking-[0.05em] text-background uppercase disabled:cursor-not-allowed disabled:opacity-40" type="button">Reveal votes</button>
              <button id="reset-round" class="mt-2 w-full cursor-pointer border border-rule px-4 py-3 font-mono text-[0.8rem] font-semibold tracking-[0.05em] uppercase hover:border-accent hover:text-accent" type="button">New round</button>
              <label class="mt-4 flex cursor-pointer items-start gap-2 text-sm text-secondary" for="allow-vote-changes">
                <input id="allow-vote-changes" class="mt-0.5 accent-[var(--site-accent)]" type="checkbox" checked />
                <span><strong class="block font-normal text-foreground">Allow vote changes after reveal</strong><span class="text-xs text-muted">Participants can recast face-up cards.</span></span>
              </label>
              <div class="mt-6 border-t border-rule pt-5">
                <label class="mb-2 block font-mono text-[0.7rem] tracking-[0.05em] text-muted uppercase" for="timer-duration">Timer duration (seconds)</label>
                <input id="timer-duration" class="w-full border border-rule bg-background px-3 py-2 font-mono text-foreground outline-none focus:border-accent" type="number" min="10" max="360" step="5" value="30" />
                <label class="mt-3 flex cursor-pointer items-center gap-2 text-sm text-secondary" for="timer-auto-reveal">
                  <input id="timer-auto-reveal" class="accent-[var(--site-accent)]" type="checkbox" />
                  Auto-reveal when time expires
                </label>
                <div class="mt-3 grid grid-cols-2 gap-2">
                  <button id="start-timer" class="cursor-pointer border border-foreground px-3 py-2 font-mono text-[0.7rem] font-semibold tracking-[0.04em] uppercase hover:border-accent hover:text-accent" type="button">Start timer</button>
                  <button id="stop-timer" class="hidden cursor-pointer border border-rule px-3 py-2 font-mono text-[0.7rem] font-semibold tracking-[0.04em] uppercase hover:border-accent hover:text-accent" type="button">Cancel timer</button>
                </div>
              </div>
            </div>

            <div class="mt-8 border-t border-rule pt-6 first:mt-0 first:border-0 first:pt-0">
              <p class="mb-4 font-mono text-[0.75rem] tracking-[0.08em] text-muted uppercase">Participants</p>
              <ol id="participant-list" class="m-0 list-none space-y-3 p-0"></ol>
            </div>
          </aside>
        </div>
      </section>
    </main>

    <dialog id="profile-dialog" class="scrum-profile-dialog m-auto w-[min(440px,calc(100%-2rem))] border border-rule bg-background p-0 text-foreground backdrop:bg-black/45">
      <form id="profile-form" class="p-7" method="dialog">
        <div class="flex items-start justify-between gap-6 border-b border-rule pb-5">
          <div>
            <p class="mb-1 font-mono text-[0.7rem] tracking-[0.1em] text-accent uppercase">Profile settings</p>
            <h2 class="m-0 font-serif text-[2rem] leading-none font-normal">How should we call you?</h2>
          </div>
          <button id="profile-close" class="grid size-8 shrink-0 cursor-pointer place-items-center border border-rule text-lg leading-none hover:border-accent hover:text-accent" type="button" aria-label="Close profile settings">×</button>
        </div>
        <p class="mt-5 mb-5 text-sm text-secondary">Your name is stored only in this browser and reused when you join another room.</p>
        <label class="mb-2 block font-mono text-[0.72rem] tracking-[0.06em] uppercase" for="profile-name">Display name</label>
        <input id="profile-name" class="w-full border border-rule bg-background px-4 py-3 text-foreground outline-none placeholder:text-muted focus:border-accent" name="profile-name" maxlength="32" autocomplete="name" placeholder="Your name" required />
        <button class="mt-4 w-full cursor-pointer bg-accent px-5 py-3 font-mono text-[0.78rem] font-semibold tracking-[0.06em] text-background uppercase hover:bg-accent-hover" type="submit">Save profile</button>
      </form>
    </dialog>

    <div id="poker-toast" class="pointer-events-none fixed right-5 bottom-5 z-50 translate-y-3 bg-foreground px-4 py-3 font-mono text-[0.75rem] tracking-[0.04em] text-background opacity-0 transition-all" role="status" aria-live="polite"></div>
  </div>
</ToolLayout>

<script src="../../scripts/scrum-poker.ts"></script>

<style is:global>
  .scrum-table {
    position: relative;
    min-height: 500px;
    overflow: hidden;
    border: 1px solid var(--site-rule);
    border-radius: 48% / 26%;
    background:
      radial-gradient(circle at center, color-mix(in srgb, var(--site-surface) 82%, transparent), transparent 65%),
      var(--site-surface);
    box-shadow: inset 0 0 0 10px var(--site-background), inset 0 0 0 11px var(--site-rule);
  }

  .scrum-profile-dialog[open] {
    animation: scrum-result-enter 180ms ease-out both;
  }

  .scrum-profile-dialog::backdrop {
    backdrop-filter: blur(2px);
  }

  .scrum-table-copy {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(360px, 55%);
    text-align: center;
    transform: translate(-50%, -50%);
  }

  .scrum-table-copy:has(.scrum-results:not(.hidden)) {
    inset: 2.75rem 2.25rem;
    width: auto;
    transform: none;
  }

  .scrum-table-copy:has(.scrum-results:not(.hidden)) .scrum-round-overview {
    display: none;
  }

  .scrum-results {
    display: grid;
    height: 100%;
    grid-template-columns: minmax(118px, 22%) minmax(210px, 1fr) minmax(140px, 25%);
    align-items: center;
    gap: 1rem;
    transform-origin: center;
  }

  .scrum-results.hidden {
    display: none;
  }

  .scrum-result-summary {
    grid-column: 1;
  }

  .scrum-result-stats {
    display: grid;
    gap: 0.5rem;
  }

  .scrum-distribution-panel {
    grid-column: 3;
    min-width: 0;
    padding: 1rem;
    border-left: 1px solid var(--site-rule);
    background: color-mix(in srgb, var(--site-background) 54%, transparent);
  }

  .scrum-results.is-entering {
    animation: scrum-result-enter 320ms ease-out both;
  }

  .scrum-result-stat {
    border: 1px solid var(--site-rule);
    background: color-mix(in srgb, var(--site-background) 76%, transparent);
    padding: 0.65rem 0.4rem;
  }

  .scrum-timer {
    display: inline-block;
    min-width: 4.5rem;
    border-bottom: 1px solid transparent;
    transform-origin: center;
  }

  .scrum-timer.is-running {
    border-color: color-mix(in srgb, var(--site-accent) 55%, transparent);
    color: var(--site-accent);
    animation: scrum-timer-tick 1s ease-in-out infinite;
  }

  .scrum-timer.is-urgent {
    border-color: var(--site-accent);
    animation-duration: 600ms;
  }

  .scrum-players {
    position: absolute;
    inset: 1.5rem;
    pointer-events: none;
  }

  .scrum-players.is-revealed {
    inset: 3.5rem 27% 3.5rem 24%;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(62px, 82px));
    place-content: center;
    align-items: start;
    gap: 1rem 0.55rem;
  }

  .scrum-player {
    position: absolute;
    top: calc(50% + sin(var(--angle)) * 43%);
    left: calc(50% + cos(var(--angle)) * 45%);
    width: 82px;
    text-align: center;
    transform: translate(-50%, -50%);
  }

  .scrum-players.is-revealed .scrum-player {
    position: static;
    width: auto;
    min-width: 0;
    transform: none;
  }

  .scrum-players.is-revealed .scrum-player-role {
    display: none;
  }

  .scrum-player-card {
    display: grid;
    width: 46px;
    height: 64px;
    margin: 0 auto 0.4rem;
    place-items: center;
    border: 1px solid var(--site-rule);
    border-radius: 5px;
    background: var(--site-background);
    color: var(--site-text);
    font-family: var(--font-serif);
    font-size: 1.4rem;
    box-shadow: 3px 3px 0 var(--site-rule);
    transition: transform 180ms ease, background 180ms ease;
  }

  .scrum-player-card.is-voted:not(.is-revealed) {
    border-color: var(--site-accent);
    background:
      repeating-linear-gradient(135deg, transparent 0 5px, color-mix(in srgb, var(--site-accent) 22%, transparent) 5px 7px),
      var(--site-background);
    color: transparent;
    transform: translateY(-4px) rotate(-2deg);
  }

  .scrum-player-card.is-revealed {
    border-color: var(--site-accent);
    color: var(--site-accent);
    transform: translateY(-4px) rotate(2deg);
  }

  .scrum-player-card.is-reveal-entering {
    animation: scrum-card-reveal 380ms cubic-bezier(0.2, 0.72, 0.25, 1) both;
    backface-visibility: hidden;
  }

  .scrum-player-name {
    display: block;
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .scrum-player-role {
    display: block;
    color: var(--site-text-muted);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .scrum-hand {
    display: flex;
    gap: 0.65rem;
    overflow-x: auto;
    padding: 0.5rem 0 1rem;
    scrollbar-color: var(--site-rule) transparent;
  }

  .scrum-hand-card {
    display: grid;
    flex: 0 0 58px;
    height: 82px;
    cursor: pointer;
    place-items: center;
    border: 1px solid var(--site-rule);
    border-radius: 5px;
    background: var(--site-surface);
    color: var(--site-text);
    font-family: var(--font-serif);
    font-size: 1.55rem;
    box-shadow: 3px 3px 0 var(--site-rule);
    transition: transform 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
  }

  .scrum-hand-card:not(:disabled):hover {
    border-color: var(--site-accent);
    color: var(--site-accent);
    transform: translateY(-5px);
  }

  .scrum-hand-card[aria-pressed="true"] {
    border-color: var(--site-accent);
    background: var(--site-accent);
    color: var(--site-background);
    box-shadow: 4px 6px 0 color-mix(in srgb, var(--site-accent) 35%, transparent);
    transform: translateY(-7px);
  }

  .scrum-hand-card:disabled {
    cursor: not-allowed;
    opacity: 0.38;
    box-shadow: 2px 2px 0 var(--site-rule);
    transform: none;
  }

  @keyframes scrum-timer-tick {
    0%, 100% {
      opacity: 0.78;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.025);
    }
  }

  @keyframes scrum-card-reveal {
    0% {
      opacity: 0.25;
      transform: translate(var(--throw-x), var(--throw-y)) rotateY(72deg) rotate(-8deg) scale(0.88);
    }
    100% {
      opacity: 1;
      transform: translate(0, -4px) rotateY(0deg) rotate(2deg) scale(1);
    }
  }

  @keyframes scrum-result-enter {
    from {
      opacity: 0;
      transform: scale(0.975);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (max-width: 47.5rem) {
    .scrum-table {
      min-height: 640px;
      border-radius: 32px;
    }

    .scrum-players {
      inset: 1rem;
    }

    .scrum-player {
      top: calc(50% + sin(var(--angle)) * 44%);
      left: calc(50% + cos(var(--angle)) * 42%);
      width: 66px;
    }

    .scrum-table-copy {
      width: 52%;
    }

    .scrum-table-copy:has(.scrum-results:not(.hidden)) {
      inset: 1.75rem;
      width: auto;
    }

    .scrum-results {
      grid-template: auto minmax(220px, 1fr) auto / minmax(0, 1fr);
      gap: 0.75rem;
    }

    .scrum-result-summary {
      grid-row: 1;
      grid-column: 1;
    }

    .scrum-result-summary > p:first-child {
      margin-bottom: 0.5rem;
    }

    .scrum-result-stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .scrum-result-summary #consensus-label {
      margin-top: 0.5rem;
    }

    .scrum-distribution-panel {
      grid-row: 3;
      grid-column: 1;
      padding: 0.75rem 1rem;
      border-top: 1px solid var(--site-rule);
      border-left: 0;
