---
import ToolLayout from '../../layouts/ToolLayout.astro';
import '../../styles/scrumPoker.css';

const cards = ['0', '1', '2', '3', '5', '8', '13', '21', '?', '☕'];
---

<ToolLayout
  title="Scrum Poker"
  description="A private, peer-to-peer planning poker tool for quick team estimates."
>
  <div data-scrum-tool>
    <header class="border-b border-rule py-5">
      <div class="flex items-end justify-between gap-8 max-mobile:items-start">
        <div>
          <p
            class="mb-1 font-mono text-[0.7rem] font-semibold tracking-[0.12em] text-accent uppercase"
          >
            Scrum Poker
          </p>
          <h1
            class="m-0 font-serif text-[clamp(1.8rem,3vw,2.8rem)] leading-none font-normal tracking-[-0.03em]"
          >
            Estimate together.
          </h1>
        </div>
        <div class="flex items-center justify-end gap-4">
          <button
            id="profile-button"
            class="grid size-9 shrink-0 cursor-pointer place-items-center rounded-full border border-rule bg-transparent p-0 text-foreground hover:border-accent-hover hover:text-accent-hover"
            type="button"
            aria-label="Open profile settings"
            title="Profile settings"
          >
            <svg
              class="size-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              aria-hidden="true"
            >
              <circle cx="12" cy="8" r="3.25"></circle>
              <path d="M5.5 19c.7-3.2 3-5 6.5-5s5.8 1.8 6.5 5"></path>
            </svg>
          </button>
          <button
            class="grid size-9 shrink-0 cursor-pointer place-items-center rounded-full border border-rule bg-transparent p-0 text-foreground hover:border-accent-hover hover:text-accent-hover"
            type="button"
            data-tool-theme-toggle
            aria-label="Switch to dark mode"
            title="Switch to dark mode"
          >
            <span class="text-base leading-none dark:hidden" aria-hidden="true"
              >☾</span
            >
            <span
              class="hidden text-base leading-none dark:inline"
              aria-hidden="true">☀</span
            >
          </button>
        </div>
      </div>
    </header>

    <main id="tool-content" class="py-[clamp(1rem,2.5vw,2rem)]">
      <section
        id="poker-setup"
        class="mx-auto max-w-[920px]"
        aria-labelledby="setup-title"
      >
        <div
          class="grid grid-cols-[1fr_auto] items-end gap-8 max-mobile:grid-cols-1"
        >
          <div>
            <p
              class="mb-3 font-mono text-[0.8rem] tracking-[0.08em] text-accent uppercase"
            >
              Start here
            </p>
            <h2
              id="setup-title"
              class="m-0 font-serif text-[clamp(2.3rem,4vw,4rem)] leading-none font-normal tracking-[-0.03em]"
            >
              Make a room or join one.
            </h2>
          </div>
          <p
            class="m-0 font-mono text-[0.75rem] tracking-[0.05em] text-muted uppercase"
          >
            No account · Private votes
          </p>
        </div>

        <div
          class="mt-12 grid grid-cols-2 border border-rule bg-surface max-mobile:grid-cols-1"
        >
          <form
            id="create-room-form"
            class="p-8 max-mobile:border-b max-mobile:border-rule max-mobile:p-6"
          >
            <span
              class="font-mono text-[0.75rem] tracking-[0.08em] text-muted uppercase"
              >01 / Create</span
            >
            <h3 class="mt-8 mb-2 font-serif text-[2rem] font-normal">
              Create a room
            </h3>
            <p class="mb-8 text-secondary">
              Start a fresh round and share the room link with your team.
            </p>
            <label
              class="mb-2 block font-mono text-[0.75rem] tracking-[0.06em] uppercase"
              for="create-name">Your name</label
            >
            <input
              id="create-name"
              class="w-full border border-rule bg-background px-4 py-3 text-foreground outline-none placeholder:text-muted focus:border-accent"
              name="name"
              maxlength="32"
              autocomplete="name"
              placeholder="e.g. Brijesh"
              required
            />
            <label
              class="mt-4 mb-2 block font-mono text-[0.75rem] tracking-[0.06em] uppercase"
              for="create-room-code"
              >Custom room ID <span class="text-muted">(optional)</span></label
            >
            <input
              id="create-room-code"
              class="w-full border border-rule bg-background px-4 py-3 font-mono tracking-[0.08em] text-foreground uppercase outline-none placeholder:text-muted focus:border-accent"
              name="room"
              minlength="1"
              maxlength="32"
              pattern="[A-Za-z0-9]+"
              autocomplete="off"
              autocapitalize="characters"
              placeholder="Leave blank for a random ID"
            />
            <button
              class="mt-4 w-full cursor-pointer bg-accent px-5 py-3 font-mono text-[0.8rem] font-semibold tracking-[0.06em] text-background uppercase hover:bg-accent-hover"
              type="submit"
              >Create room <span aria-hidden="true">↗</span></button
            >
          </form>

          <form
            id="join-room-form"
            class="border-l border-rule p-8 max-mobile:border-l-0 max-mobile:p-6"
          >
            <span
              class="font-mono text-[0.75rem] tracking-[0.08em] text-muted uppercase"
              >02 / Participate</span
            >
            <h3 class="mt-8 mb-2 font-serif text-[2rem] font-normal">
              Join your team
            </h3>
            <p class="mb-8 text-secondary">
              Use the uppercase alphanumeric room ID shared by your team.
            </p>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label
                  class="mb-2 block font-mono text-[0.75rem] tracking-[0.06em] uppercase"
                  for="join-name">Your name</label
                >
                <input
                  id="join-name"
                  class="w-full border border-rule bg-background px-4 py-3 text-foreground outline-none placeholder:text-muted focus:border-accent"
                  name="name"
                  maxlength="32"
                  autocomplete="name"
                  placeholder="Your name"
                  required
                />
              </div>
              <div>
                <label
                  class="mb-2 block font-mono text-[0.75rem] tracking-[0.06em] uppercase"
                  for="room-code">Room code</label
                >
                <input
                  id="room-code"
                  class="w-full border border-rule bg-background px-4 py-3 font-mono tracking-[0.12em] text-foreground uppercase outline-none placeholder:text-muted focus:border-accent"
                  name="room"
                  minlength="1"
                  maxlength="32"
                  pattern="[A-Za-z0-9]+"
                  autocomplete="off"
                  autocapitalize="characters"
                  placeholder="ABC1234"
                  required
                />
              </div>
            </div>
            <button
              class="mt-4 w-full cursor-pointer border border-foreground px-5 py-3 font-mono text-[0.8rem] font-semibold tracking-[0.06em] uppercase hover:border-accent hover:text-accent"
              type="submit">Join room <span aria-hidden="true">→</span></button
            >
          </form>
        </div>

        <div
          id="connection-error"
          class="mt-4 hidden border-l-[3px] border-accent bg-surface px-5 py-4 text-secondary"
          role="alert"
        >
        </div>

        <aside
          class="mt-8 grid grid-cols-[auto_1fr] gap-4 border-t border-rule pt-6 text-sm text-secondary"
        >
          <span class="mt-1 size-2 rounded-full bg-accent" aria-hidden="true"
          ></span>
          <p class="m-0">
            <strong class="text-foreground">Private by design.</strong> PeerJS introduces
            browsers through its public signalling service; names and votes then move
            over encrypted WebRTC connections. Names and votes are not stored; browser
            preferences stay on this device.
          </p>
        </aside>
      </section>

      <section id="poker-room" class="hidden" aria-labelledby="room-heading">
        <div
          class="flex items-center justify-between gap-6 border-b border-rule pb-5 max-mobile:items-start"
        >
          <div>
            <p
              id="connection-label"
              class="mb-1 flex items-center gap-2 font-mono text-[0.75rem] tracking-[0.08em] text-muted uppercase"
            >
              <span
                id="connection-dot"
                class="size-2 rounded-full bg-muted"
                aria-hidden="true"></span>
              Connecting
            </p>
            <h2
              id="room-heading"
              class="m-0 font-serif text-[clamp(2rem,4vw,3.6rem)] leading-none font-normal"
            >
              Room <span
                id="room-label"
                class="font-mono text-[0.7em] tracking-[0.08em] text-accent"
              ></span>
            </h2>
          </div>
          <div class="flex flex-wrap justify-end gap-2">
            <button
              id="copy-room"
              class="cursor-pointer border border-rule px-4 py-2 font-mono text-[0.75rem] tracking-[0.05em] uppercase hover:border-accent hover:text-accent"
              type="button">Copy invite</button
            >
            <button
              id="leave-room"
              class="cursor-pointer border border-rule px-4 py-2 font-mono text-[0.75rem] tracking-[0.05em] uppercase hover:border-accent hover:text-accent"
              type="button">Leave</button
            >
          </div>
        </div>

        <div
          class="mt-8 grid grid-cols-[minmax(0,1fr)_280px] gap-8 max-mobile:grid-cols-1"
        >
          <div>
            <div class="scrum-table">
              <div class="scrum-table-copy">
                <div class="scrum-round-overview">
                  <p
                    id="round-label"
                    class="mb-2 font-mono text-[0.75rem] tracking-[0.08em] text-muted uppercase"
                  >
                    Round 1
                  </p>
                  <p
                    id="round-status"
                    class="m-0 font-serif text-[clamp(1.5rem,3vw,2.5rem)] leading-tight"
                  >
                    Waiting for estimates
                  </p>
                  <p
                    id="timer-display"
                    class="scrum-timer mt-4 mb-0 font-mono text-lg tracking-[0.08em] text-muted"
                    aria-live="polite"
                  >
                    2:00
                  </p>
                </div>
                <div
                  id="statistics"
                  class="scrum-results hidden"
                  aria-live="polite"
                >
                  <section class="scrum-result-summary">
                    <p
                      class="mb-3 font-mono text-[0.7rem] tracking-[0.08em] text-accent uppercase"
                    >
                      Round result
                    </p>
                    <div class="scrum-result-stats">
                      <div class="scrum-result-stat">
                        <strong
                          id="stat-most-voted"
                          class="block font-serif text-2xl font-normal"
                          >—</strong
                        ><span
                          class="font-mono text-[0.6rem] text-muted uppercase"
                          >Most voted</span
                        >
                      </div>
                      <div class="scrum-result-stat">
                        <strong
                          id="stat-low"
                          class="block font-serif text-2xl font-normal"
                          >—</strong
                        ><span
                          class="font-mono text-[0.6rem] text-muted uppercase"
                          >Low</span
                        >
                      </div>
                      <div class="scrum-result-stat">
                        <strong
                          id="stat-high"
                          class="block font-serif text-2xl font-normal"
                          >—</strong
                        ><span
                          class="font-mono text-[0.6rem] text-muted uppercase"
                          >High</span
                        >
                      </div>
                    </div>
                    <p
                      id="consensus-label"
                      class="mt-3 mb-0 text-sm text-secondary"
                    >
                    </p>
                  </section>
                  <section
                    class="scrum-distribution-panel"
                    aria-label="Vote distribution"
                  >
                    <p
                      class="mb-3 font-mono text-[0.65rem] tracking-[0.08em] text-muted uppercase"
                    >
                      Vote spread
                    </p>
                    <div id="distribution" class="space-y-2 text-left"></div>
                  </section>
                </div>
              </div>
              <div id="players-grid" class="scrum-players" aria-live="polite">
              </div>
            </div>

            <div class="mt-8">
              <div class="mb-4 flex items-end justify-between gap-4">
                <div>
                  <p
                    class="mb-1 font-mono text-[0.75rem] tracking-[0.08em] text-accent uppercase"
                  >
                    Your estimate
                  </p>
                  <h3 class="m-0 font-serif text-[1.7rem] font-normal">
                    Choose a card
                  </h3>
                </div>
                <p id="card-hint" class="m-0 text-sm text-muted">
                  Tap again to clear
                </p>
              </div>
              <div
                id="card-hand"
                class="scrum-hand"
                role="group"
                aria-label="Estimate cards"
              >
                {
                  cards.map((card) => (
                    <button
                      class="scrum-hand-card"
                      type="button"
                      data-card={card}
                      aria-pressed="false"
                    >
                      {card}
                    </button>
                  ))
                }
              </div>
            </div>
          </div>

          <aside
            class="border-l border-rule pl-8 max-mobile:border-t max-mobile:border-l-0 max-mobile:pt-8 max-mobile:pl-0"
          >
            <div id="room-controls">
              <p
                class="mb-4 font-mono text-[0.75rem] tracking-[0.08em] text-accent uppercase"
              >
                Room controls
              </p>
              <button
                id="reveal-votes"
                class="w-full cursor-pointer bg-accent px-4 py-3 font-mono text-[0.8rem] font-semibold tracking-[0.05em] text-background uppercase disabled:cursor-not-allowed disabled:opacity-40"
                type="button">Reveal votes</button
              >
              <button
                id="reset-round"
                class="mt-2 w-full cursor-pointer border border-rule px-4 py-3 font-mono text-[0.8rem] font-semibold tracking-[0.05em] uppercase hover:border-accent hover:text-accent"
                type="button">New round</button
              >
              <label
                class="mt-4 flex cursor-pointer items-start gap-2 text-sm text-secondary"
                for="allow-vote-changes"
              >
                <input
                  id="allow-vote-changes"
                  class="mt-0.5 accent-[var(--site-accent)]"
                  type="checkbox"
                  checked
                />
                <span
                  ><strong class="block font-normal text-foreground"
                    >Allow vote changes after reveal</strong
                  ><span class="text-xs text-muted"
                    >Participants can recast face-up cards.</span
                  ></span
                >
              </label>
              <div class="mt-6 border-t border-rule pt-5">
                <label
                  class="mb-2 block font-mono text-[0.7rem] tracking-[0.05em] text-muted uppercase"
                  for="timer-duration">Timer duration (seconds)</label
                >
                <input
                  id="timer-duration"
                  class="w-full border border-rule bg-background px-3 py-2 font-mono text-foreground outline-none focus:border-accent"
                  type="number"
                  min="10"
                  max="360"
                  step="5"
                  value="30"
                />
                <label
                  class="mt-3 flex cursor-pointer items-center gap-2 text-sm text-secondary"
                  for="timer-auto-reveal"
                >
                  <input
                    id="timer-auto-reveal"
                    class="accent-[var(--site-accent)]"
                    type="checkbox"
                  />
                  Auto-reveal when time expires
                </label>
                <div class="mt-3 grid grid-cols-2 gap-2">
                  <button
                    id="start-timer"
                    class="cursor-pointer border border-foreground px-3 py-2 font-mono text-[0.7rem] font-semibold tracking-[0.04em] uppercase hover:border-accent hover:text-accent"
                    type="button">Start timer</button
                  >
                  <button
                    id="stop-timer"
                    class="hidden cursor-pointer border border-rule px-3 py-2 font-mono text-[0.7rem] font-semibold tracking-[0.04em] uppercase hover:border-accent hover:text-accent"
                    type="button">Cancel timer</button
                  >
                </div>
              </div>
            </div>

            <div
              class="mt-8 border-t border-rule pt-6 first:mt-0 first:border-0 first:pt-0"
            >
              <p
                class="mb-4 font-mono text-[0.75rem] tracking-[0.08em] text-muted uppercase"
              >
                Participants
              </p>
              <ol id="participant-list" class="m-0 list-none space-y-3 p-0">
              </ol>
            </div>
          </aside>
        </div>
      </section>
    </main>

    <dialog
      id="profile-dialog"
      class="scrum-profile-dialog m-auto w-[min(440px,calc(100%-2rem))] border border-rule bg-background p-0 text-foreground backdrop:bg-black/45"
    >
      <form id="profile-form" class="p-7" method="dialog">
        <div
          class="flex items-start justify-between gap-6 border-b border-rule pb-5"
        >
          <div>
            <p
              class="mb-1 font-mono text-[0.7rem] tracking-[0.1em] text-accent uppercase"
            >
              Profile settings
            </p>
            <h2 class="m-0 font-serif text-[2rem] leading-none font-normal">
              How should we call you?
            </h2>
          </div>
          <button
            id="profile-close"
            class="grid size-8 shrink-0 cursor-pointer place-items-center border border-rule text-lg leading-none hover:border-accent hover:text-accent"
            type="button"
            aria-label="Close profile settings">×</button
          >
        </div>
        <p class="mt-5 mb-5 text-sm text-secondary">
          Your name is stored only in this browser and reused when you join
          another room.
        </p>
        <label
          class="mb-2 block font-mono text-[0.72rem] tracking-[0.06em] uppercase"
          for="profile-name">Display name</label
        >
        <input
          id="profile-name"
          class="w-full border border-rule bg-background px-4 py-3 text-foreground outline-none placeholder:text-muted focus:border-accent"
          name="profile-name"
          maxlength="32"
          autocomplete="name"
          placeholder="Your name"
          required
        />
        <button
          class="mt-4 w-full cursor-pointer bg-accent px-5 py-3 font-mono text-[0.78rem] font-semibold tracking-[0.06em] text-background uppercase hover:bg-accent-hover"
          type="submit">Save profile</button
        >
      </form>
    </dialog>

    <div
      id="poker-toast"
      class="pointer-events-none fixed right-5 bottom-5 z-50 translate-y-3 bg-foreground px-4 py-3 font-mono text-[0.75rem] tracking-[0.04em] text-background opacity-0 transition-all"
      role="status"
      aria-live="polite"
    >
    </div>
  </div>
</ToolLayout>

<script src="../../scripts/scrumPoker/index.ts"></script>
