---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import TextLink from '../components/TextLink.astro';
---

<BaseLayout
  title="Page not found"
  description="The requested page could not be found."
>
  <script is:inline>
    (() => {
      // GitHub Pages cannot create static files for arbitrary room codes. Its
      // custom 404 is the production fallback; the middleware provides the
      // equivalent rewrite in Astro's development server.
      const match = globalThis.location.pathname.match(
        /^\/tools\/scrum-poker\/([^/]+)\/?$/i,
      );
      if (!match) return;
      const roomCode = decodeURIComponent(match[1])
        .toUpperCase()
        .replaceAll(/[^A-Z0-9]/g, '')
        .slice(0, 32);
      if (!roomCode) return;
      globalThis.location.replace(
        `/tools/scrum-poker?room=${encodeURIComponent(roomCode)}`,
      );
    })();
  </script>
  <PageHeader
    eyebrow="404 / Not found"
    title="This route ends here."
    description="The page may have moved, or the address may be incomplete. Head back to the portfolio or browse the latest writing."
  >
    <p>
      <TextLink href="/" accent>Return home ←</TextLink>
    </p>
  </PageHeader>
</BaseLayout>
