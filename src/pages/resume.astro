---
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import FeatureItem from '../components/FeatureItem.astro';
import Notice from '../components/Notice.astro';
import PageHeader from '../components/PageHeader.astro';
import TextLink from '../components/TextLink.astro';
---

<BaseLayout
  title="Resume"
  description="Resume and professional summary for software engineer Brijesh Bhakta."
>
  <PageHeader
    eyebrow="Resume"
    title="A decade across product engineering."
    description="Backend services, web applications, and mobile product infrastructure, grounded in a Computer Science Engineering education."
  />
  <section
    class="grid grid-cols-[1fr_2fr] gap-8 border-b border-rule py-[clamp(5rem,10vw,10rem)] max-mobile:grid-cols-1"
  >
    <div>
      <Eyebrow>Resume archive</Eyebrow>
      <Notice>
        This PDF may not reflect my latest experience. Please get in touch for the most up-to-date version.
      </Notice>
    </div>
    <div class="max-w-[760px]">
      <h2
        class="mb-8 font-serif text-[clamp(2.4rem,5vw,5rem)] leading-[0.98] font-normal tracking-[-0.035em]"
      >
        Resume
      </h2>
      <p
        class="max-w-[720px] text-[clamp(1.2rem,2vw,1.55rem)] leading-normal text-secondary"
      >
        Download my five-page resume for details on my education, earlier experience, technical skills, and projects.
      </p>
      <TextLink href="/resume.pdf" download accent>Download resume ↓</TextLink>
    </div>
  </section>
  <section class="border-b border-rule py-[clamp(5rem,10vw,10rem)]">
    <Eyebrow>At a glance</Eyebrow>
    <FeatureGrid>
      <FeatureItem title="Experience">
        <p>
          Building software professionally since 2016, across product, platform, and application development.
        </p>
      </FeatureItem>
      <FeatureItem title="Range">
        <p>
          Experience across Node.js, React, React Native, Java, Python, PHP, Angular, relational databases, MongoDB and DynamoDB.
        </p>
      </FeatureItem>
      <FeatureItem title="Education">
        <p>
          B.Tech in Computer Science Engineering from Uka Tarsadia University, 2016.
        </p>
      </FeatureItem>
    </FeatureGrid>
  </section>
</BaseLayout>
