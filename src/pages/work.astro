---
import BaseLayout from '../layouts/BaseLayout.astro';
import Notice from '../components/Notice.astro';
import PageHeader from '../components/PageHeader.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { projects } from '../data/work';

---

<BaseLayout
  title="Work"
  description="Selected backend, web, and mobile product work from Brijesh Bhakta's portfolio."
>
  <PageHeader
    eyebrow="Selected work"
    title="Engineering across systems and screens."
    description="A selection of product work across backend systems, web applications, and mobile products."
  />
  <section
    class="pb-[clamp(2rem,5vw,5rem)]"
    aria-label="Project archive"
  >
    <div class="py-16">
      <Notice>
        <strong>Archive note:</strong> These summaries cover work across different stages of my career. Client and employer names are intentionally omitted.
      </Notice>
    </div>
    <div class="border-t border-rule">
      {
        projects.map((project) => <ProjectRow project={project} />)
      }
    </div>
  </section>
</BaseLayout>
