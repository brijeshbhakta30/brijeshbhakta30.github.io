---
import MadeWithLove from '../components/MadeWithLove.astro';
import DocumentLayout from './DocumentLayout.astro';

interface Props {
  title: string;
  description: string;
  fillViewport?: boolean;
}

const { title, description, fillViewport = false } = Astro.props;
---

<DocumentLayout title={title} description={description}>
  <a
    class="fixed -top-24 left-4 z-20 bg-foreground px-4 py-3 text-background focus:top-4"
    href="#tool-content">Skip to tool</a
  >
  <div
    class:list={[
      'mx-auto w-[min(1500px,calc(100%-48px))] max-mobile:w-[min(100%-28px,1500px)]',
      fillViewport && 'flex min-h-svh flex-col',
    ]}
  >
    <slot />
    <footer
      class:list={[
        'flex items-center justify-center gap-1.5 border-t border-rule py-6 text-sm text-muted',
        fillViewport && 'mt-auto',
      ]}
    >
      <MadeWithLove
        iconClass="size-3.5"
        linkClass="text-foreground underline decoration-rule underline-offset-4 hover:decoration-accent"
      />
    </footer>
  </div>
</DocumentLayout>
