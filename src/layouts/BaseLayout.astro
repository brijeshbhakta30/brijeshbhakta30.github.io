---
import { ClientRouter } from 'astro:transitions';
import DocumentLayout from './DocumentLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import portrait from '../assets/brijesh.jpg';

interface Props {
  title: string;
  description: string;
  image?: string;
  article?: boolean;
}

const {
  title,
  description,
  image = portrait.src,
  article = false,
} = Astro.props;
---

<DocumentLayout
  title={title}
  description={description}
  image={image}
  article={article}
>
  <ClientRouter slot="head" />
  <a
    class="fixed -top-24 left-4 z-20 bg-foreground px-4 py-3 text-background focus:top-4"
    href="#main-content">Skip to content</a
  >
  <div
    class="mx-auto w-[min(1380px,calc(100%-48px))] max-mobile:w-[min(100%-28px,1380px)]"
  >
    <SiteHeader />
    <main id="main-content" class="[view-transition-name:page-content]">
      <slot />
    </main>
    <SiteFooter />
  </div>
  <script is:inline slot="body-end">
    document.addEventListener('astro:before-preparation', () => {
      document.documentElement.dataset.navigating = 'true';
    });
    document.addEventListener('astro:page-load', () => {
      delete document.documentElement.dataset.navigating;
    });
  </script>
</DocumentLayout>
